#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJ   3

#define HYPER LG(LC(LA(LSHFT)))

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    // Hold LOWER + RAISE together to automatically open the ADJUST (Bluetooth/F-Keys) layer
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJ>;
        };
    };

    behaviors {
        // Smart Shift on thumb: Tap = Sticky Shift, Double-Tap = CapsWord (for ID), Hold = Regular Shift
        shft_morph: shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        smart_shft: smart_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&shft_morph>;
        };
    };

    macros {
        de_ae: de_ae { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LA(U) &kp A>; };
        de_oe: de_oe { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LA(U) &kp O>; };
        de_ue: de_ue { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LA(U) &kp U>; };
        de_sz: de_sz { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LA(S)>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // -----------------------------------------------------------------------------------------
        // LAYER 0: STANDARD 42-KEY CORNE (COLEMAK-DH)
        // Outer columns act just like a normal keyboard. Thumbs are dedicated.
        // -----------------------------------------------------------------------------------------
        default_layer {
            display-name = "BASE";
            // |  TAB |  Q  |  W  |  F  |  P  |  B  | xxx | xxx |  J  |  L  |  U  |  Y  |  ;  | BSPC |
            // | CTRL |  A  |  R  |  S  |  T  |  G  | xxx | xxx |  M  |  N  |  E  |  I  |  O  |  '   |
            // | SHFT |  Z  |  X  |  C  |  D  |  V  |           |  K  |  H  |  ,  |  .  |  /  | ESC  |
            //                    | CMD | LWR | SPC |           |S-SHF| RSE |HYPER|
            bindings = <
                &kp TAB   &kp Q &kp W &kp F &kp P &kp B &none &none &kp J &kp L &kp U     &kp Y   &kp SEMI &kp BSPC
                &kp LCTRL &kp A &kp R &kp S &kp T &kp G &none &none &kp M &kp N &kp E     &kp I   &kp O    &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp D &kp V             &kp K &kp H &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &kp LGUI &mo LOWER &kp SPACE        &smart_shft RSHFT 0 &mo RAISE &kp HYPER
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 1: LOWER (Hold Left Middle Thumb) -> SYMBOLS & BRACKETS & NAVIGATION
        // Cmd is still on your Left Thumb, so Cmd + '+' or Cmd + '-' works just like a normal keyboard!
        // -----------------------------------------------------------------------------------------
        lower_layer {
            display-name = "SYM_NAV";
            // |  `   |  !  |  @  |  #  |  $  |  %  | xxx | xxx |  ^  |  &   |  *  |  -  |  =  | DEL  |
            // | CTRL |  ß  |  ä  |  (  |  {  |  [  | xxx | xxx | LFT | DWN  |  UP | RGT |  :  |  "   |
            // | SHFT |  ü  |  ö  |  )  |  }  |  ]  |           | HOME| PGDN |PGUP | END |  \  |  |   |
            //                    | CMD | ___ | SPC |           | RET | ADJ  |HYPER|
            bindings = <
                &kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &none &none &kp CARET &kp AMPS  &kp STAR  &kp MINUS &kp EQUAL &kp DEL
                &kp LCTRL &de_sz   &de_ae &kp LPAR &kp LBRC &kp LBKT  &none &none &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp COLON &kp DQT
                &kp LSHFT &de_ue   &de_oe &kp RPAR &kp RBRC &kp RBKT              &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp BSLH  &kp PIPE
                                          &kp LGUI &trans   &kp SPACE             &kp RET   &mo RAISE &kp HYPER
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 2: RAISE (Hold Right Middle Thumb) -> NUMPAD (Right Hand) & SHORTCUTS
        // -----------------------------------------------------------------------------------------
        raise_layer {
            display-name = "NUMPAD";
            // |  ~   |     |     |     |     |     | xxx | xxx |  /  |  7  |  8  |  9  |  -  | BSPC |
            // | CTRL | CMD | OPT | CTRL| SHFT|     | xxx | xxx |  *  |  4  |  5  |  6  |  +  |  =   |
            // | SHFT | UNDO| CUT | COPY| PSTE|     |           |  0  |  1  |  2  |  3  |  .  | ENT  |
            //                    | CMD | ADJ | SPC |           | RET | ___ |  0  |
            bindings = <
                &kp TILDE &none     &none     &none     &none     &none &none &none &kp FSLH &kp N7 &kp N8 &kp N9 &kp MINUS &kp BSPC
                &kp LCTRL &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &none &none &none &kp STAR &kp N4 &kp N5 &kp N6 &kp PLUS  &kp EQUAL
                &kp LSHFT &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &none             &kp N0   &kp N1 &kp N2 &kp N3 &kp DOT   &kp RET
                                              &kp LGUI  &mo LOWER &kp SPACE         &kp RET  &trans &kp N0
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 3: ADJUST (Hold BOTH Lower + Raise Thumbs) -> BLUETOOTH & F-KEYS
        // -----------------------------------------------------------------------------------------
        adjust_layer {
            display-name = "SYSTEM";
            // | BTCLR| BT0 | BT1 | BT2 | BT3 |     | xxx | xxx |     |  F7 |  F8 |  F9 | F12 |      |
            // |      |     |     |     |     |     | xxx | xxx |     |  F4 |  F5 |  F6 | F11 |      |
            // |      |     |     |     |     |     |           |     |  F1 |  F2 |  F3 | F10 |      |
            //                    |     | ___ |     |           |     | ___ |     |
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none &none &none &none &kp F7 &kp F8 &kp F9 &kp F12 &none
                &none      &none        &none        &none        &none        &none &none &none &none &kp F4 &kp F5 &kp F6 &kp F11 &none
                &none      &none        &none        &none        &none        &none             &none &kp F1 &kp F2 &kp F3 &kp F10 &none
                                                     &trans       &trans       &trans            &trans &trans &trans
            >;
        };
    };
};
