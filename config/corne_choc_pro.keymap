#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJ   3
#define HYPER LG(LC(LA(LSHFT)))

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJ>;
        };
    };

    behaviors {
        shft_morph: shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_shft: smart_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&shft_morph>;
        };
    };

    macros {
        de_ae: de_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp A>;
        };

        de_oe: de_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp O>;
        };

        de_ue: de_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp U>;
        };

        de_sz: de_sz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(S)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp F                  &kp P      &kp B      &none  &none  &kp J                &kp L      &kp U          &kp Y    &kp SEMI  &kp BSPC
&kp TAB    &kp A  &kp R  &kp S                  &kp T      &kp G      &none  &none  &kp M                &kp N      &kp E          &kp I    &kp O     &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C                  &kp D      &kp V                    &kp K                &kp H      &kp COMMA      &kp DOT  &kp FSLH  &kp ENTER
                         &sk LA(LC(LG(LSHFT)))  &mo LOWER  &kp SPACE                &smart_shft RSHFT 0  &mo RAISE  &kp RIGHT_GUI
            >;
        };

        lower_layer {
            display-name = "Numbers";
            bindings = <
&kp TILDE  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_VOLUME_UP    &trans  &trans  &kp FSLH  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp DEL
&trans     &none  &none       &none     &none       &kp C_VOLUME_DOWN  &trans  &trans  &kp STAR  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp EQUAL
&trans     &none  &none       &none     &none       &kp C_MUTE                         &kp N0    &kp N1  &kp N2  &kp N3  &kp DOT    &trans
                              &trans    &trans      &trans                             &trans    &trans  &trans
            >;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
&kp GRAVE  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PERCENT  &trans  &trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &none     &kp DEL
&kp UNDER  &kp COLON  &kp EQUAL  &kp LPAR  &kp LBRC  &kp LBKT     &trans  &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none     &trans
&kp CARET  &kp AMPS   &kp PIPE   &kp RPAR  &kp RBRC  &kp RBKT                     &de_ae     &de_oe    &de_ue    &de_sz     &kp BSLH  &trans
                                 &trans    &trans    &trans                       &trans     &trans    &trans
            >;
        };

        adjust_layer {
            display-name = "SYSTEM";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none   &none  &none  &none   &kp F7  &kp F8  &kp F9  &kp F12  &none
&none       &none         &none         &none         &none         &none   &none  &none  &none   &kp F4  &kp F5  &kp F6  &kp F11  &none
&none       &none         &none         &none         &none         &none                 &none   &kp F1  &kp F2  &kp F3  &kp F10  &none
                                        &trans        &trans        &trans                &trans  &trans  &trans
            >;
        };
    };
};
